# Copy to .env (never commit .env)

# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# PostgreSQL (docker-compose overrides DB_URL to point at the postgres service)
DB_URL=jdbc:postgresql://localhost:5432/mesapronta
DB_USER=mesapronta
DB_PASSWORD=mesapronta
# Host port for postgres in docker-compose (change if 5432 is already taken)
DB_HOST_PORT=5432

# RabbitMQ (docker-compose overrides RABBIT_HOST to point at the rabbitmq service)
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
